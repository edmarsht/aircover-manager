rules_version = '2';

/* Règles de sécurité Firestore — AirCover Manager.
   À coller manuellement dans Firebase Console > Firestore Database > Règles > Publier
   (pas de CLI Firebase installée dans ce repo). */

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    /* Deux comptes sont liés si l'un des deux a l'autre dans sa liste de
       collaborateurs — le lien créé à l'acceptation d'une invitation est donc
       symétrique même s'il n'écrit que sur le compte de l'utilisateur qui accepte. */
    function linked(a, b) {
      return a in get(/databases/$(database)/documents/accounts/$(b)).data.collaboratorUids
          || b in get(/databases/$(database)/documents/accounts/$(a)).data.collaboratorUids;
    }

    function canAccess(ownerUid) {
      return signedIn() && (request.auth.uid == ownerUid || linked(request.auth.uid, ownerUid));
    }

    match /accounts/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
    }

    match /invites/{id} {
      allow create: if signedIn() && request.auth.token.email == request.resource.data.fromEmail;
      /* Lecture séparée en deux règles distinctes (une par champ) plutôt qu'un
         `in [fromEmail, toEmail]` unique : Firestore ne peut valider une requête
         de liste que si son `where()` correspond exactement à la règle. Un `in`
         portant sur deux champs différents n'est pas prouvable pour une requête
         qui ne filtre que sur l'un des deux — la requête entière était alors
         rejetée (permission-denied), même pour son propre auteur. */
      allow read: if signedIn() && request.auth.token.email == resource.data.fromEmail;
      allow read: if signedIn() && request.auth.token.email == resource.data.toEmail;
      allow update: if signedIn() && request.auth.token.email in [resource.data.fromEmail, resource.data.toEmail];
    }

    match /aircovers/{id} {
      allow read, update, delete: if canAccess(resource.data.ownerUid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /apartments/{id} {
      allow read, update, delete: if canAccess(resource.data.ownerUid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /users/{id} {
      allow read, update, delete: if canAccess(resource.data.ownerUid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
